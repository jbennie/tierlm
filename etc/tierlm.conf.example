# tierlm.conf.example -- every engine preference with its built-in default.
#
# `sudo tierlm-setup` probes the machine and writes /etc/tierlm/tierlm.conf
# for you; this file documents the keys. Copy it to /etc/tierlm/tierlm.conf
# only if you want to manage the file by hand (`tierlm-setup --show` then
# prints every effective value and where it came from).
#
# Syntax: one `key = value` per line; '#' starts a comment unless inside
# double quotes; later lines override earlier ones. Sizes take K/M/G/T
# (powers of 1024), fractions take 0.3 or 30%, booleans yes/no/on/off/
# true/false, lists are comma separated. `include <glob>` reads more files
# (lexical order, at most 4 levels deep).
#
# Precedence (later wins): built-in defaults < hardware.conf < tierlm.conf <
# conf.d/*.conf (lexical) < TIERLM_<KEY> environment variables (dots become
# underscores: TIERLM_CPU_THREADS) < command-line flags.

# -- CPU ---------------------------------------------------------------
cpu.threads              = auto        # compute threads; auto = 1 per physical core
cpu.thread_groups        = ccd         # ccd | none: run each routed expert inside one L3 domain
cpu.pin                  = yes         # pin compute threads to physical cores

# -- Memory ------------------------------------------------------------
memory.ram_reserve       = auto        # RAM left for the OS; auto = max(4G, 10% of RAM)
memory.expert_cache      = auto        # expert slot cache; auto = RAM - reserve - dense weights
memory.pin_frac          = 0.30        # share of the cache kept for the pinned hot set
memory.hugepages         = thp         # thp | off | explicit (preallocated vm.nr_hugepages)

# -- I/O ---------------------------------------------------------------
io.backend               = pread       # pread | io_uring (needs make URING=1 and kernel.io_uring_disabled = 0)
io.direct                = no          # O_DIRECT expert reads; tierlm-setup --drive measures whether it helps
io.queue_depth           = 32          # outstanding reads per drive (io_uring), 1..4096
io.threads_per_drive     = 4           # pread workers per drive, 1..256
io.drives                =             # expert store mount points, e.g. /srv/tlm/nvme0, /srv/tlm/nvme1
io.prefetch              = router      # router | off: prefetch layer l+1's experts from its router
io.lookahead_k           = 0           # experts hinted per layer by the router lookahead; 0 = top_k

# -- Navigation (docs/design/navigation.md) -------------------------------
nav.interest_aggressiveness = 0.0       # "this question needs"; 0 = legacy fixed prefetch breadth

# -- KV cache ----------------------------------------------------------
kv.device                = cpu         # cpu, or GPUs such as hip:0, hip:1 (layers split across them)
kv.vram_frac             = 0.05        # share of each GPU's VRAM for KV pages; hard cap 0.10
kv.dtype                 = f16         # f16 | f8_e4m3 | f32; f8_e4m3 doubles the context that fits
kv.page_tokens           = 64          # tokens per KV page, 16..1024

# -- Speculative decoding ----------------------------------------------
spec.mode                = off         # off | mtp (the model's own multi-token-prediction head)
spec.shape               = chain       # chain
spec.depth               = auto        # 0..4, or auto = chosen per step by measured utility
spec.union_guard         = yes         # trim drafts that would pull too many experts from disk
spec.restrict_experts    = no          # lossy expert-restricted drafting; opt-in only

# -- Quantisation and compile defaults ---------------------------------
quant.experts            = q6_k        # q6_k | q5_k | q4_k | q8_0 | native (keep shipped FP4/FP8)
quant.dense              = q8_0        # q8_0 | f16 | bf16 | native; never below q8_0
quant.mtp_head           = q8_0        # q8_0 | f16 | bf16 | native; never below q8_0
compile.profile          = exact       # exact (lossless) | balanced | aggressive (mixed precision, pruning)

# -- Paths, server and logging -----------------------------------------
paths.models             = /srv/tlm/models
paths.kv_store           = /var/lib/tierlm/kv
paths.log                = /var/log/tierlm
server.listen            = 127.0.0.1:8000
log.level                = warn        # error | warn | info | debug

# -- Experts and content -----------------------------------------------
# Depth per content type (types are listed in content-taxonomy.conf):
# exclude | shallow | standard | deep. A child type (content.code.python)
# inherits its parent's depth (content.code) unless set itself.
# Excluding a type only makes *specialist* experts (focused/narrow, >= 80%
# of their label mass in excluded types, < 5% in deep types) pruning
# candidates; REAP saliency and the eval gate decide what goes. Pruning
# needs compile.profile = balanced or aggressive.
content.default          = standard
# content.code           = deep
# content.code.python    = deep
# content.tools          = deep
# content.lang.ja        = exclude
# content.law            = exclude

experts.protect          =             # layer:expert ids never pruned or demoted, e.g. 12:178, 17:44
experts.exclude          =             # layer:expert ids to remove (still eval-gated)
prune.max_ratio          = 0.25        # cap on the share of routed experts removed, 0..0.5
prune.min_keep_per_layer = 0.5         # share of experts per layer that always survive, 0.5..1

# -- Decision engine ---------------------------------------------------
decide.backend           = rules       # rules | self | encoder (encoder falls back to rules until ported)
# decide.encoder_model   = /usr/share/tierlm/decide/openjevx-q8_0.tlmd
decide.auto_threshold    = 0.90        # apply decisions at or above this confidence
decide.ask_threshold     = 0.60        # below this the safe default is taken (must be <= auto)
decide.log               = /var/lib/tierlm/decisions

include conf.d/*.conf
